generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  DEACTIVATED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

enum RoleScope {
  PLATFORM
  BUSINESS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  WAREHOUSE
  ZONE
  AISLE
  RACK
  SHELF
  BIN
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE_ISSUE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_COUNT
  DISPOSAL
  OPENING_BALANCE
}

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum AdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

enum ReturnType {
  CUSTOMER
  SUPPLIER
}

enum ReturnStatus {
  DRAFT
  REQUESTED
  APPROVED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnCondition {
  RESALABLE
  DAMAGED
  EXPIRED
  DISPOSED
  RETURNED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(320)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  firstName String @map("first_name") @db.VarChar(100)
  lastName String @map("last_name") @db.VarChar(100)
  phone String? @db.VarChar(40)
  avatarUrl String? @map("avatar_url") @db.VarChar(2048)
  status AccountStatus @default(PENDING)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberships BusinessMembership[]
  invitationsSent Invitation[] @relation("InvitationInviter")
  notifications Notification[]
  auditLogs AuditLog[]
  createdBusinesses Business[] @relation("BusinessOwner")
  createdPurchases PurchaseOrder[] @relation("PurchaseCreator")
  approvedPurchases PurchaseOrder[] @relation("PurchaseApprover")
  createdSales Sale[] @relation("SaleCreator")
  createdTransfers StockTransfer[] @relation("TransferCreator")
  approvedTransfers StockTransfer[] @relation("TransferApprover")
  receivedTransfers StockTransfer[] @relation("TransferReceiver")
  createdAdjustments StockAdjustment[] @relation("AdjustmentCreator")
  approvedAdjustments StockAdjustment[] @relation("AdjustmentApprover")
  performedCounts StockCount[] @relation("StockCountCreator")
  approvedCounts StockCount[] @relation("StockCountApprover")
  createdReturns Return[] @relation("ReturnCreator")
  approvedReturns Return[] @relation("ReturnApprover")
  createdMovements StockMovement[] @relation("MovementCreator")
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  @@index([status])
  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Business {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(200)
  registrationNumber String? @map("registration_number") @db.VarChar(100)
  businessType String? @map("business_type") @db.VarChar(100)
  industry String? @db.VarChar(100)
  email String? @db.VarChar(320)
  phone String? @db.VarChar(40)
  address String? @db.VarChar(500)
  location String? @db.VarChar(200)
  website String? @db.VarChar(2048)
  logoUrl String? @map("logo_url") @db.VarChar(2048)
  currency String @default("USD") @db.Char(3)
  timeZone String @default("UTC") @map("time_zone") @db.VarChar(100)
  status BusinessStatus @default(PENDING)
  ownerId String @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation("BusinessOwner", fields: [ownerId], references: [id])
  memberships BusinessMembership[]
  invitations Invitation[]
  roles Role[]
  categories Category[]
  brands Brand[]
  units Unit[]
  products Product[]
  suppliers Supplier[]
  customers Customer[]
  warehouses Warehouse[]
  locations Location[]
  inventoryBalances InventoryBalance[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  sales Sale[]
  stockTransfers StockTransfer[]
  stockAdjustments StockAdjustment[]
  stockCounts StockCount[]
  returns Return[]
  notifications Notification[]
  auditLogs AuditLog[]
  settings BusinessSetting[]
  @@index([status])
  @@index([ownerId])
  @@map("businesses")
}

model BusinessMembership {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  status MembershipStatus @default(INVITED)
  joinedAt DateTime? @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles MembershipRole[]
  @@unique([businessId, userId])
  @@index([userId, status])
  @@map("business_memberships")
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  businessId String? @map("business_id") @db.Uuid
  name String @db.VarChar(100)
  description String? @db.VarChar(500)
  scope RoleScope
  isSystem Boolean @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]
  invitations Invitation[]
  @@unique([businessId, name])
  @@index([scope])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(150)
  description String? @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  roles RolePermission[]
  @@map("permissions")
}

model RolePermission {
  roleId String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  membership BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Invitation {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  email String @db.VarChar(320)
  tokenHash String @unique @map("token_hash") @db.VarChar(255)
  roleId String? @map("role_id") @db.Uuid
  invitedById String @map("invited_by_id") @db.Uuid
  status InvitationStatus @default(PENDING)
  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt DateTime @default(now()) @map("created_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  invitedBy User @relation("InvitationInviter", fields: [invitedById], references: [id])
  @@index([businessId, email, status])
  @@index([expiresAt, status])
  @@map("invitations")
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  name String @db.VarChar(150)
  description String? @db.VarChar(500)
  parentId String? @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  @@unique([businessId, name])
  @@index([businessId, parentId])
  @@map("categories")
}

model Brand {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  name String @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
  @@unique([businessId, name])
  @@map("brands")
}

model Unit {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  name String @db.VarChar(100)
  symbol String? @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
  @@unique([businessId, name])
  @@map("units")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  brandId String? @map("brand_id") @db.Uuid
  unitId String? @map("unit_id") @db.Uuid
  sku String @db.VarChar(100)
  barcode String? @db.VarChar(100)
  name String @db.VarChar(200)
  description String? @db.Text
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(14, 2)
  sellingPrice Decimal? @map("selling_price") @db.Decimal(14, 2)
  reorderLevel Decimal @default(0) @map("reorder_level") @db.Decimal(14, 3)
  taxRate Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  imageUrl String? @map("image_url") @db.VarChar(2048)
  trackBatches Boolean @default(false) @map("track_batches")
  trackExpiry Boolean @default(false) @map("track_expiry")
  status ProductStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplierLinks ProductSupplier[]
  inventory InventoryBalance[]
  batches ProductBatch[]
  purchaseItems PurchaseOrderItem[]
  saleItems SaleItem[]
  movementItems StockMovementItem[]
  transferItems StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  countItems StockCountItem[]
  returnItems ReturnItem[]
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, name])
  @@map("products")
}

model Supplier {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  name String @db.VarChar(200)
  email String? @db.VarChar(320)
  phone String? @db.VarChar(40)
  address String? @db.VarChar(500)
  taxInformation String? @map("tax_information") @db.VarChar(255)
  paymentTerms String? @map("payment_terms") @db.VarChar(100)
  creditLimit Decimal? @map("credit_limit") @db.Decimal(14, 2)
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products ProductSupplier[]
  purchases PurchaseOrder[]
  returns Return[]
  @@unique([businessId, name])
  @@map("suppliers")
}

model ProductSupplier {
  productId String @map("product_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  name String @db.VarChar(200)
  email String? @db.VarChar(320)
  phone String? @db.VarChar(40)
  address String? @db.VarChar(500)
  creditLimit Decimal? @map("credit_limit") @db.Decimal(14, 2)
  paymentTerms String? @map("payment_terms") @db.VarChar(100)
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales Sale[]
  returns Return[]
  @@unique([businessId, name])
  @@map("customers")
}

model Warehouse {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  name String @db.VarChar(150)
  code String @db.VarChar(50)
  address String? @db.VarChar(500)
  managerName String? @map("manager_name") @db.VarChar(200)
  phone String? @db.VarChar(40)
  status WarehouseStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locations Location[]
  inventories InventoryBalance[]
  purchases PurchaseOrder[]
  sales Sale[]
  transfersFrom StockTransfer[] @relation("TransferSourceWarehouse")
  transfersTo StockTransfer[] @relation("TransferDestinationWarehouse")
  @@unique([businessId, code])
  @@unique([businessId, name])
  @@map("warehouses")
}

model Location {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name String @db.VarChar(150)
  code String @db.VarChar(50)
  type LocationType @default(BIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent Location? @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationTree")
  inventories InventoryBalance[]
  movements StockMovement[]
  adjustmentItems StockAdjustmentItem[]
  countItems StockCountItem[]
  @@unique([warehouseId, code])
  @@index([businessId, warehouseId])
  @@map("locations")
}

model ProductBatch {
  id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  batchNumber String @map("batch_number") @db.VarChar(100)
  expiryDate DateTime? @map("expiry_date")
  receivedAt DateTime? @map("received_at")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories InventoryBalance[]
  movementItems StockMovementItem[]
  purchaseItems PurchaseOrderItem[]
  saleItems SaleItem[]
  transferItems StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  countItems StockCountItem[]
  returnItems ReturnItem[]
  @@unique([productId, batchNumber])
  @@index([expiryDate])
  @@map("product_batches")
}

model InventoryBalance {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  batchId String? @map("batch_id") @db.Uuid
  quantity Decimal @default(0) @db.Decimal(18, 3)
  reservedQty Decimal @default(0) @map("reserved_quantity") @db.Decimal(18, 3)
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  batch ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  @@unique([productId, locationId, batchId])
  @@index([businessId, productId])
  @@index([businessId, warehouseId])
  @@map("inventory_balances")
}

model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  orderNumber String @map("order_number") @db.VarChar(100)
  status PurchaseStatus @default(DRAFT)
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
  total Decimal @default(0) @db.Decimal(14, 2)
  notes String? @db.Text
  orderedAt DateTime? @map("ordered_at")
  receivedAt DateTime? @map("received_at")
  createdById String @map("created_by_id") @db.Uuid
  approvedById String? @map("approved_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User @relation("PurchaseCreator", fields: [createdById], references: [id])
  approvedBy User? @relation("PurchaseApprover", fields: [approvedById], references: [id])
  items PurchaseOrderItem[]
  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id String @id @default(uuid()) @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  batchId String? @map("batch_id") @db.Uuid
  orderedQty Decimal @map("ordered_quantity") @db.Decimal(18, 3)
  receivedQty Decimal @default(0) @map("received_quantity") @db.Decimal(18, 3)
  unitCost Decimal @map("unit_cost") @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax Decimal @default(0) @db.Decimal(14, 2)
  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  batch ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  @@index([productId])
  @@map("purchase_order_items")
}

model Sale {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  invoiceNumber String @map("invoice_number") @db.VarChar(100)
  status SalesStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
  total Decimal @default(0) @db.Decimal(14, 2)
  notes String? @db.Text
  soldAt DateTime? @map("sold_at")
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User @relation("SaleCreator", fields: [createdById], references: [id])
  items SaleItem[]
  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@index([businessId, soldAt])
  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  batchId String? @map("batch_id") @db.Uuid
  quantity Decimal @db.Decimal(18, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax Decimal @default(0) @db.Decimal(14, 2)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  batch ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  @@index([productId])
  @@map("sale_items")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  type StockMovementType
  reference String? @db.VarChar(100)
  notes String? @db.Text
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
